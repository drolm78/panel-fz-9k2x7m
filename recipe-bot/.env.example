# --- Telegram ---
# Token que te da @BotFather al crear el bot
TELEGRAM_TOKEN=123456:ABC-DEF...
# Tu user id numerico de Telegram (preguntaselo a @userinfobot).
# OBLIGATORIO: sin esto cualquiera que descubra el bot gasta tus creditos.
# Varios ids separados por coma.
TELEGRAM_ALLOWED_USERS=123456789

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- Airtable ---
# Personal Access Token con scopes data.records:write (+ schema.bases:write
# solo si vas a correr scripts/setup_airtable.py)
AIRTABLE_TOKEN=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE=Recetas

# Base "Atenea": ahi vive la tabla Master, la contabilidad.
# Es otra base, asi que el mismo token necesita acceso a las dos.
# Si la dejas vacia, el bot sigue haciendo recetas pero no registra gastos.
AIRTABLE_BASE_ATENEA=app...
AIRTABLE_TABLA_MASTER=Master
# Tabla de cuentas y tarjetas a la que apunta el campo "Forma de pago".
AIRTABLE_TABLA_SUMANDOS=Sumandos

# Base "2026 Extraespecial": expedientes y recetas medicas.
# Vacia = el bot no registra recetas, todo lo demas sigue igual.
AIRTABLE_BASE_CONSULTA=app...
AIRTABLE_TABLA_NOTAS=Notas
AIRTABLE_TABLA_PACIENTES=Pacientes

# --- Transcripcion (API compatible con OpenAI /audio/transcriptions) ---
# Tambien es lo que transcribe tus notas de voz, no solo el audio de los videos.
# OpenAI:  https://api.openai.com/v1   modelo whisper-1
# Groq:    https://api.groq.com/openai/v1   modelo whisper-large-v3-turbo (mas barato y rapido)
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_API_KEY=sk-...
TRANSCRIBE_MODEL=whisper-1

# --- Opcional ---
# Archivo de cookies en formato Netscape para Instagram/Facebook privados.
# Sin esto, para IG/FB comparte el ARCHIVO de video en vez del link.
# COOKIES_FILE=/data/cookies.txt
MAX_FRAMES=16
FRAME_WIDTH=640
